 graph_agent.py       | 64 +++++++++++++++++++++++++++++++++++++++-----
 orchestrator.py      | 13 ++++++---
 qa_agent.py          | 10 ++++---
 report_generator.py  | 15 ++++++-----
 static/css/style.css | 12 +++++++++
 static/js/app.js     | 35 +++++++++++++++++++++---
 static/js/chat.js    |  4 +--
 templates/index.html | 17 ++++++------
 vector_store.py      | 63 +++++++++++++++++++++++++++++++++++--------
 10 files changed, 190 insertions(+), 44 deletions(-)

