# ─────────────────────────────────────────────────────────────────────────────
# AutoInvoice Intelligence — Environment Configuration Example
# ─────────────────────────────────────────────────────────────────────────────

# --- Brevo (Sendinblue) Free Tier Transactional Email API ---
# 1. Sign up at https://www.brevo.com (free plan provides 300 emails/day)
# 2. Go to SMTP & API -> API Keys -> Generate a new v3 API key
# 3. Add and validate your sender email address under Senders & IP
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_validated_sender@example.com
BREVO_SENDER_NAME="AutoInvoice Ledger"

# --- Authentication & Session Security ---
# Secret key for signing PyJWT access tokens (min 32 bytes recommended for production)
JWT_SECRET=super_secret_jwt_random_key_change_me_in_production_32bytes

# Cookie security: set to true in production with HTTPS, false for local dev (HTTP)
COOKIE_SECURE=false

# --- LLM & Vision Model API Keys ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-120b

# --- Database & Storage Paths ---
DATABASE_URL=sqlite+aiosqlite:///./invoices.db
SYNC_DATABASE_URL=sqlite:///./invoices.db
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=invoices
CHAT_DB_PATH=./invoices.db
